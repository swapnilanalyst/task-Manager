{
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.0",
    "@cypress/webpack-preprocessor": "^7.0.1",
    "@faker-js/faker": "^10.1.0",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.34.1",
    "chai-soft-assert": "^0.2.0",
    "cypress": "^15.3.0",
    "cypress-iframe": "^1.0.1",
    "cypress-xpath": "^2.0.1",
    "rimraf": "^6.1.2"
  },
  "scripts": {
    "test:report": "cypress run --env allure=true",
    "test:spec": "cypress run --env allure=true --spec",
    "clean:allure": "rimraf allure-results allure-report",
    "allure:generate": "rimraf allure-report && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "pretest:report": "npm run clean:allure",
    "posttest:report": "npm run allure:generate && npm run allure:open"
  },
  "dependencies": {
    "chance": "^1.1.13",
    "mongodb": "^7.0.0"
  }
}
